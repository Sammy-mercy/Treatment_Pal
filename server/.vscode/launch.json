{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Server",
      "request": "launch",
      "type": "node",
      "program": "${workspaceFolder}/server.js",
      "restart": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Start Server (Nodemon Dev)",
      "request": "launch",
      "type": "node",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    }
  ]
}
